# ── Model & runtime ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=

# ── Veritabanı (SALT OKUNUR) ───────────────────────────────────────────────
# locus_agent_ro rolüne bağlı kullanıcı. sql/agent_readonly_role.sql'i
# uyguladıktan sonra Supabase Dashboard > Database > Roles'tan oluştur.
#
# ⚠️  service_role veya postgres kullanıcısı KOYMA — tüm güvenlik modeli
#     bu bağlantının salt-okunur olmasına dayanıyor.
AGENT_DB_URL=postgresql://locus_agent:PAROLA@db.PROJE.supabase.co:5432/postgres

# ── Yazma işlemleri (Next.js API üzerinden) ────────────────────────────────
LOCUS_API_BASE=http://localhost:3000
# Next.js tarafındaki AGENT_API_SECRET ile AYNI olmalı.
AGENT_API_SECRET=
