# Tek kaynak — kopyala: cp .env.example .env
# Vercel: aynı isimleri Environment Variables olarak ekle (dosya yüklenmez).

SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Uygulama girişi (server-only — NEXT_PUBLIC_ kullanmayın)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
AUTH_SECRET=uzun-rastgele-bir-gizli-anahtar

# Panorama → musteriler transform cron (/api/sync/panorama)
# Vercel Cron bu değeri Authorization: Bearer … olarak gönderir.
CRON_SECRET=uzun-rastgele-cron-gizli-anahtar

# Ana sayfa “Şimdi çek” → n8n Webhook Manuel Sync (server-only)
# n8n webhook Auth=None; Guard node X-N8N-Sync-Secret. Production URL (/webhook/...).
N8N_PANORAMA_MANUAL_WEBHOOK_URL=
N8N_PANORAMA_MANUAL_WEBHOOK_SECRET=

# Google Places (prospecting smoke / n8n Config)
GOOGLE_PLACES_API_KEY=

# Google Routes API — /rotalar durak sırası + trafikli ETA (server-only).
# GCP projesinde "Routes API" etkin olmalı ve faturalandırma açık olmalı.
# NEXT_PUBLIC_ YAPMAYIN: anahtar yalnız /api/rota/optimize içinden kullanılır.
GOOGLE_MAPS_API_KEY=

# ── AI Agent (kendi sunucumuz — LangGraph) ─────────────────────────────────
# Agent ayağa kalktıktan sonra doldurulur — bkz. agent/README.md
# Frontend proxy'si (/api/agent) bunları SUNUCUDA kullanır, tarayıcıya sızmaz.
AGENT_URL=http://127.0.0.1:2024/runs/stream
# Frontend → agent paylaşilan sır (başlık: x-agent-secret). 40+ karakter rastgele.
# AGENT_API_SECRET ile KARIŞTIRMA: o agent → frontend yazma araçları içindir.
AGENT_INGRESS_SECRET=
# Yalnız agent/agent.py içindeki name= değiştirilirse gerekir.
# ASSISTANT_ID=locus-analyst

# Agent'ın Next.js'e geri yazarken kullandığı paylaşılan sır.
# agent/.env içindeki AGENT_API_SECRET ile AYNI olmalı.
# Yalnız /api/notlar ve /api/musteri/favori POST'larında geçerli (middleware.ts).
AGENT_API_SECRET=uzun-rastgele-agent-gizli-anahtar

# Anthropic Usage & Cost Admin API (Ayarlar sayfası). Sıradan sk-ant-api… değil.
# Console → Settings → Admin API keys → sk-ant-admin01-…
# Bireysel hesapta yok; Organization gerekir. Vercel env'e de ekleyin.
ANTHROPIC_ADMIN_KEY=

# Agent'in SALT OKUNUR veritabani baglantisi.
# Supavisor pooler kullan: db.<ref>.supabase.co yalniz IPv6 yayinliyor ve
# IPv4-only aglardan "failed to resolve host" verir.
# Kullanici adi pooler'da <rol>.<proje_ref> bicimindedir.
# ⚠️  service_role veya postgres KOYMA — 1. guvenlik katmani devre disi kalir.
AGENT_DB_URL=postgresql://locus_agent.PROJE_REF:PAROLA@aws-0-BOLGE.pooler.supabase.com:5432/postgres
