# Tek kaynak — kopyala: cp .env.example .env
# Vercel: aynı isimleri Environment Variables olarak ekle (dosya yüklenmez).

SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Uygulama girişi (server-only — NEXT_PUBLIC_ kullanmayın)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
AUTH_SECRET=uzun-rastgele-bir-gizli-anahtar

# Panorama → musteriler transform cron (/api/sync/panorama)
# Vercel Cron bu değeri Authorization: Bearer … olarak gönderir.
CRON_SECRET=uzun-rastgele-cron-gizli-anahtar

# Google Places (prospecting smoke / n8n Config)
GOOGLE_PLACES_API_KEY=

# ── AI Agent (Managed Deep Agents / LangSmith) ─────────────────────────────
# Agent dağıtıldıktan sonra doldurulur — bkz. agent/README.md
# Frontend proxy'si (/api/agent) bu ikisini SUNUCUDA kullanır, tarayıcıya sızmaz.
LANGSMITH_AGENT_URL=
LANGSMITH_API_KEY=
# Hesap AB bolgesinde. Bu satir olmadan `mda` varsayilan ABD ucuna gider ve
# HER komut "Forbidden (HTTP 403)" verir — anahtar gecerli olsa bile.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Yalniz agent/agent.py icindeki name= degistirilirse gerekir.
# LANGSMITH_ASSISTANT_ID=locus-analyst

# Agent'ın Next.js'e geri yazarken kullandığı paylaşılan sır.
# agent/.env içindeki AGENT_API_SECRET ile AYNI olmalı.
# Yalnız /api/notlar ve /api/musteri/favori POST'larında geçerli (middleware.ts).
AGENT_API_SECRET=uzun-rastgele-agent-gizli-anahtar

# Agent'in SALT OKUNUR veritabani baglantisi.
# Supavisor pooler kullan: db.<ref>.supabase.co yalniz IPv6 yayinliyor ve
# IPv4-only aglardan "failed to resolve host" verir.
# Kullanici adi pooler'da <rol>.<proje_ref> bicimindedir.
# ⚠️  service_role veya postgres KOYMA — 1. guvenlik katmani devre disi kalir.
AGENT_DB_URL=postgresql://locus_agent.PROJE_REF:PAROLA@aws-0-BOLGE.pooler.supabase.com:5432/postgres
