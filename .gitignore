# Sir tasiyan her .env turevi — yedek/kopya dahil.
# `.env` tek basina yalniz tam esitligi yakalar; .env.yedek-2026… gibi
# dosyalar izlenmeden kalirdi.
.env
.env.*
!.env.example
agent/.env
__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# backend (Python ETL)
backend/__pycache__/
backend/cikti/etl_log.txt

# frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
frontend/*.tsbuildinfo

# .env.example commit edilir (şifre yok)
# Eski MDA build artığı (üretilmez)
agent/.mda/
agent/.venv/
